# Auxiliary membership index; retain the pinned module and ordered account list.
set(_account_dir "${CMAKE_BINARY_DIR}/playerbot_accounts")
file(MAKE_DIRECTORY "${_account_dir}")

file(READ "${playerbots_SOURCE_DIR}/playerbot/PlayerbotAIConfig.cpp" _account_text)
string(REPLACE "\r\n" "\n" _account_text "${_account_text}")
string(SHA256 _account_hash "${_account_text}")
if(NOT _account_hash STREQUAL "7a9802b6eaa1cb4e8a1fdf9adb362dda9177a7d67e1bba559095f0a34af8c6c4")
  message(FATAL_ERROR "Review account index: pinned PlayerbotAIConfig.cpp changed")
endif()
string(REPLACE [==[return find(randomBotAccounts.begin(), randomBotAccounts.end(), id) != randomBotAccounts.end();]==] [==[return ManTech::PlayerbotAccountMembership().Contains(id);]==] _account_text "${_account_text}")
set(_account_text "#include \"Util/AccountMembershipIndex.h\"\n${_account_text}")
file(WRITE "${_account_dir}/PlayerbotAIConfig.cpp.in" "${_account_text}")
configure_file("${_account_dir}/PlayerbotAIConfig.cpp.in" "${_account_dir}/PlayerbotAIConfig.cpp" COPYONLY)
get_target_property(_account_sources playerbots SOURCES)
set(_account_matches ${_account_sources})
list(FILTER _account_matches INCLUDE REGEX "(^|/)PlayerbotAIConfig[.]cpp$")
list(LENGTH _account_matches _account_count)
if(NOT _account_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one PlayerbotAIConfig.cpp source")
endif()
list(REMOVE_ITEM _account_sources ${_account_matches})
list(APPEND _account_sources "${_account_dir}/PlayerbotAIConfig.cpp")
set_property(TARGET playerbots PROPERTY SOURCES "${_account_sources}")
set_source_files_properties("${_account_dir}/PlayerbotAIConfig.cpp" TARGET_DIRECTORY playerbots
  PROPERTIES INCLUDE_DIRECTORIES "${playerbots_SOURCE_DIR}/playerbot")

file(READ "${playerbots_SOURCE_DIR}/playerbot/RandomPlayerbotFactory.cpp" _account_text)
